# Committed defaults. Override locally in .env.local or per environment in CI.
VITE_API_BASE_URL=https://dummyjson.com
# Minutes. Set to 1 to watch the silent refresh-token flow in the Network tab.
VITE_ACCESS_TOKEN_TTL_MIN=30
# Runtime list of remotes. Point this at a per-environment URL in production.
VITE_MFE_REGISTRY_URL=/mfe.registry.json
